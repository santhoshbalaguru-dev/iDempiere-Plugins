# Copy to .env (git-ignored) and fill in. Loaded from the working directory when the service starts.
DB_URL=jdbc:postgresql://localhost:5432/payment_service
DB_USER=payment_service
DB_PASSWORD=change-me

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Secret set on the Razorpay webhook. While it is empty every webhook is rejected with 401.
RAZORPAY_WEBHOOK_SECRET=change-me

# Must match "Service API Key" in the iDempiere Payment Gateway Configuration window
PAYMENT_SERVICE_API_KEY=change-me